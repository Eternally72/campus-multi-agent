# Build outputs generated by Maven.
target/

# Local IDE and editor metadata.
.vscode/
.idea/
*.iml

# Local environment files that may contain API keys, database passwords, or JWT secrets.
.env
.env.*
!.env.example
src/main/resources/application-local.yml
src/main/resources/application-*.local.yml

# Runtime logs and temporary files.
*.log
logs/
tmp/

# Local-only development notes. Public project docs should not use the .local.md suffix.
*.local.md
